{
  "name": "okchroma",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Color token engine: one brand hex in, a full WCAG-enforced light+dark token system out (CSS variables, DTCG JSON, Figma variables)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egerrity/okchroma.git"
  },
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.mjs",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.mjs",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": [
    "dist-lib",
    "tokens"
  ],
  "sideEffects": false,
  "scripts": {
    "build:lib": "node esbuild.config.js --lib && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "generate": "node dist/build-script.js",
    "demo:build": "node esbuild.config.js",
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "audit": "esbuild scripts/dark-audit.ts --bundle --platform=node --outfile=dist/dark-audit.js && node dist/dark-audit.js",
    "audit:alpha": "esbuild scripts/alpha-audit.ts --bundle --platform=node --outfile=dist/alpha-audit.js && node dist/alpha-audit.js",
    "audit:alpha:bless": "esbuild scripts/alpha-audit.ts --bundle --platform=node --outfile=dist/alpha-audit.js && node dist/alpha-audit.js --bless",
    "audit:bless": "esbuild scripts/dark-audit.ts --bundle --platform=node --outfile=dist/dark-audit.js && node dist/dark-audit.js --bless",
    "band-audit": "esbuild scripts/band-audit.ts --bundle --platform=node --outfile=dist/band-audit.js && node dist/band-audit.js",
    "band-audit:bless": "esbuild scripts/band-audit.ts --bundle --platform=node --outfile=dist/band-audit.js && node dist/band-audit.js --bless",
    "audit:divergence": "esbuild scripts/divergence-audit.ts --bundle --platform=node --outfile=dist/divergence-audit.js && node dist/divergence-audit.js",
    "audit:divergence:bless": "esbuild scripts/divergence-audit.ts --bundle --platform=node --outfile=dist/divergence-audit.js && node dist/divergence-audit.js --bless",
    "smooth": "esbuild scripts/smoothness-audit.ts --bundle --platform=node --outfile=dist/smoothness-audit.js && node dist/smoothness-audit.js",
    "smooth:baseline": "esbuild scripts/smoothness-audit.ts --bundle --platform=node --outfile=dist/smoothness-audit.js && node dist/smoothness-audit.js --baseline",
    "figma:verify": "esbuild scripts/figma-verify.ts --bundle --platform=node --outfile=dist/figma-verify.js && node dist/figma-verify.js",
    "req:audit": "esbuild scripts/reqtoken-audit.ts --bundle --platform=node --outfile=dist/reqtoken-audit.js && node dist/reqtoken-audit.js",
    "audit:secondary": "esbuild scripts/secondary-audit.ts --bundle --platform=node --outfile=dist/secondary-audit.js && node dist/secondary-audit.js",
    "audit:guarantee": "esbuild scripts/guarantee-audit.ts --bundle --platform=node --outfile=dist/guarantee-audit.js && node dist/guarantee-audit.js",
    "plugin:build": "node esbuild.config.js --plugin",
    "plugin-unify:build": "node esbuild.config.js --plugin-unify",
    "plugin-ext:build": "node esbuild.config.js --plugin-ext",
    "audit:register": "esbuild scripts/register-audit.ts --bundle --platform=node --outfile=dist/register-audit.js && node dist/register-audit.js",
    "audit:ext": "esbuild scripts/ext-override-audit.ts --bundle --platform=node --outfile=dist/ext-override-audit.js && node dist/ext-override-audit.js",
    "audit:ext:bless": "esbuild scripts/ext-override-audit.ts --bundle --platform=node --outfile=dist/ext-override-audit.js && node dist/ext-override-audit.js --bless",
    "audit:cta-apca": "esbuild scripts/cta-apca-audit.ts --bundle --platform=node --outfile=dist/cta-apca-audit.js && node dist/cta-apca-audit.js",
    "audit:desc": "esbuild scripts/desc-audit.ts --bundle --platform=node --outfile=dist/desc-audit.js && node dist/desc-audit.js",
    "name-lint": "esbuild scripts/name-lint.ts --bundle --platform=node --outfile=dist/name-lint.js && node dist/name-lint.js",
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc --noEmit -p plugin-ext",
    "docs:lint": "esbuild scripts/docs-lint.ts --bundle --platform=node --outfile=dist/docs-lint.js && node dist/docs-lint.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "helmlab": "^0.14.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
